# Server
PORT=5000
NODE_ENV=development
# Use NODE_ENV=production only with explicit production secrets and database
# transport settings. The current config rejects missing JWT secrets in production.
# TRUST_PROXY is false by default. If a known reverse proxy is used, set an
# explicit value such as loopback or a comma-separated proxy CIDR list. Do not
# use TRUST_PROXY=true without a reviewed network boundary.
# TRUST_PROXY=loopback

# Database - Windows Auth (default, no user/pass needed)
DB_HOST=localhost
DB_PORT=1433
DB_TRUSTED_CONNECTION=true
DB_NAME=gymer
# Development defaults preserve the current local SQL Server setup. For
# production use DB_ENCRYPT=true and DB_TRUST_SERVER_CERTIFICATE=false with a
# certificate chain trusted by the runtime.
DB_ENCRYPT=false

# Database - SQL Auth (uncomment and set TRUSTED_CONNECTION=false)
# DB_USER=sa
# DB_PASSWORD=*** DB_TRUSTED_CONNECTION=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT (placeholders only; never commit real secrets)
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=gymfit-api
JWT_AUDIENCE=gymfit-web
# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# MAIL_* is used by Product Order bank-transfer notifications.
# SMTP_* may still be used by legacy membership flows; keep the two configurations separate.
# MAIL_MODE=acceptance is test-only and additionally requires NODE_ENV=test
# plus a guarded disposable acceptance DB name. Never enable it in production.
# MAIL_MODE=acceptance

# Bank transfer notifications (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_QR_IMAGE_URL=/images/payment/bank-qr.jpg
ORDER_CURRENCY=VND

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# CORS
CORS_ORIGIN=http://localhost:5173
# Refresh-cookie transport (PHASE 25). Keep the cookie host-only; do not add a
# Domain attribute. Development follows the current same-site localhost proxy
# topology. Production must choose these explicitly for its real topology.
REFRESH_COOKIE_NAME=gymfit_refresh_token
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
# Rate limits use the in-memory store by default. These values are centralized
# in backend/src/config/config.ts; they do not provide distributed protection.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=10
REDIS_URL=redis://localhost:6379
DISABLE_BACKGROUND_RUNNERS=0
ORDER_RESERVATION_MINUTES=30
ORDER_EXPIRATION_BATCH_SIZE=100
ORDER_EXPIRATION_INTERVAL_SECONDS=60

# Seller marketplace mutation rate limits
SELLER_APPLICATION_WRITE_RATE_LIMIT_MAX=30
SELLER_APPLICATION_WRITE_RATE_LIMIT_WINDOW_MS=900000
SELLER_APPLICATION_SUBMIT_RATE_LIMIT_MAX=5
SELLER_APPLICATION_SUBMIT_RATE_LIMIT_WINDOW_MS=86400000
SELLER_APPLICATION_WITHDRAW_RATE_LIMIT_MAX=10
SELLER_APPLICATION_WITHDRAW_RATE_LIMIT_WINDOW_MS=86400000
BRAND_REQUEST_RATE_LIMIT_MAX=10
BRAND_REQUEST_RATE_LIMIT_WINDOW_MS=86400000

# Assistant configuration. Keep any provider key backend-only; never use
# VITE_* for an AI secret. AI_BASE_URL is optional when the provider default
# endpoint is suitable.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
# AI_BASE_URL=https://api.openai.com/v1
